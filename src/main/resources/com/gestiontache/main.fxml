<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestiontache.controller.MainController"
            stylesheets="@style.css" styleClass="root-pane">
    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="14" right="16" bottom="8" left="16"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="prevDayButton" text="◀" onAction="#onPreviousDay" styleClass="icon-button"/>
                <Label fx:id="dateLabel" styleClass="date-label"/>
                <Button fx:id="nextDayButton" text="▶" onAction="#onNextDay" styleClass="icon-button"/>
                <Button fx:id="todayButton" text="Aujourd'hui" onAction="#onToday"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Rechercher une tache (titre ou description)..." prefWidth="320"/>
                <Button fx:id="clearSearchButton" text="✕" onAction="#onClearSearch" styleClass="icon-button"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </VBox>
    </top>
    <center>
        <ListView fx:id="taskListView" BorderPane.alignment="CENTER" styleClass="task-list"/>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="bottom-bar">
            <padding>
                <Insets top="10" right="16" bottom="14" left="16"/>
            </padding>
            <Button fx:id="addTaskButton" text="+ Ajouter une tache" onAction="#onAddTask" styleClass="primary-button"/>
            <Button fx:id="reportButton" text="Reporter les taches non terminees a demain" onAction="#onReportUnfinished"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="count-label"/>
        </HBox>
    </bottom>
</BorderPane>
