<ContentDialog
    x:Class="GestionTaches.Dialogs.TaskEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="OK"
    CloseButtonText="Annuler"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="380">
        <TextBox x:Name="TitleBox" Header="Titre" TextChanged="OnTitleChanged" />
        <TextBox x:Name="DescriptionBox" Header="Description" AcceptsReturn="True"
                 TextWrapping="Wrap" Height="100" />
        <ComboBox x:Name="PriorityCombo" Header="Priorite" HorizontalAlignment="Stretch"
                  DisplayMemberPath="Label" />
        <CalendarDatePicker x:Name="DatePickerField" Header="Date" HorizontalAlignment="Stretch" />
    </StackPanel>
</ContentDialog>
