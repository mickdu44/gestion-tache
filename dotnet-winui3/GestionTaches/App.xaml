<Application
    x:Class="GestionTaches.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PriorityHauteBrush" Color="#FEE2E2" />
            <SolidColorBrush x:Key="PriorityHauteTextBrush" Color="#991B1B" />
            <SolidColorBrush x:Key="PriorityMoyenneBrush" Color="#FEF3C7" />
            <SolidColorBrush x:Key="PriorityMoyenneTextBrush" Color="#92400E" />
            <SolidColorBrush x:Key="PriorityBasseBrush" Color="#DBEAFE" />
            <SolidColorBrush x:Key="PriorityBasseTextBrush" Color="#1E40AF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
